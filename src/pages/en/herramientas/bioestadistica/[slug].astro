---
// Gemela inglesa de /herramientas/bioestadistica/[slug]: mismo slug, mismo
// contenido de la colección, bloque `en` del YAML.
import { getCollection } from 'astro:content';
import CalculadoraPage from '../../../../components/pages/CalculadoraPage.astro';

export async function getStaticPaths() {
  const calculadoras = await getCollection('calculadoras');
  return calculadoras.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---
<CalculadoraPage lang="en" entry={entry} />
