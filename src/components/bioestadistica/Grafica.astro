---
// Gráfica de la calculadora. El SVG lo produce `nucleo/svg.ts`, el mismo módulo
// que usa el controlador al recalcular, y aquí solo se envuelve en un `<figure>`.
//
// Los estilos son GLOBALES a propósito: el SVG que el navegador inserta con
// `innerHTML` no lleva el atributo de ámbito que Astro añade en build, así que
// con estilos de componente se vería distinto al recalcular. Todos los colores
// salen de los tokens del sitio.
interface Props {
  svg: string;
  titulo: string;
}
const { svg, titulo } = Astro.props;
---

<figure class="grafica" data-grafica-figura>
  <div class="grafica__lienzo" data-grafica set:html={svg} />
  <figcaption class="grafica__pie">{titulo}</figcaption>
</figure>

<style>
  .grafica {
    margin-top: var(--sp-3);
    padding: var(--sp-2);
    border: 1px solid var(--udg-gray-200);
    border-radius: var(--radius-md);
    background: #fff;
  }
  .grafica[hidden] { display: none; }
  .grafica__lienzo { width: 100%; }
  .grafica__pie {
    margin-top: var(--sp-1);
    font-size: var(--fs-xs);
    color: var(--udg-gray-500);
    line-height: var(--lh-normal);
  }
</style>

<style is:global>
  /* El tamaño de letra viaja en el propio SVG (`font-size`), donde se calcula el
     reparto del lienzo; aquí solo se define el color. El `max-width` es el del
     `viewBox`: por encima el dibujo no crece y las letras quedan a su tamaño. */
  .bio-svg {
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
    margin-inline: auto;
    font-family: var(--font-sans);
  }
  .bio-svg__etiqueta { fill: var(--udg-gray-700); }
  .bio-svg__ic,
  .bio-svg__tope {
    stroke: var(--udg-gray-500);
    stroke-width: 2;
  }
  .bio-svg__punto { fill: var(--udg-gray-500); }
  .bio-svg__fila.is-destacada .bio-svg__ic,
  .bio-svg__fila.is-destacada .bio-svg__tope { stroke: var(--udg-navy-700); stroke-width: 3; }
  .bio-svg__fila.is-destacada .bio-svg__punto { fill: var(--udg-navy-700); }
  .bio-svg__fila.is-destacada .bio-svg__etiqueta { fill: var(--udg-navy-900); font-weight: 600; }
  .bio-svg__eje { stroke: var(--udg-gray-300); stroke-width: 1; }
  .bio-svg__tick { stroke: var(--udg-gray-300); stroke-width: 1; }
  .bio-svg__tick-texto {
    fill: var(--udg-gray-500);
    font-variant-numeric: tabular-nums;
  }
  .bio-svg__ref {
    stroke: var(--udg-gray-300);
    stroke-width: 1;
    stroke-dasharray: 4 3;
  }
  /* Rótulo de un panel adicional del bosque (p. ej. «Razones de verosimilitud»). */
  .bio-svg__panel-titulo {
    fill: var(--udg-navy-900);
    font-weight: 600;
  }

  /* Series (curvas, rectas del nomograma y sus muestras en la leyenda).
     La destacada va sólida y en navy; las demás, en gris y con un patrón de
     trazo distinto cada una: la gráfica tiene que leerse igual impresa en
     blanco y negro. Nunca rojo junto al navy en el mismo componente. */
  .bio-svg__curva,
  .bio-svg__leyenda,
  .bio-svg__fagan-linea {
    fill: none;
    stroke: var(--udg-gray-700);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bio-svg__curva.is-destacada,
  .bio-svg__leyenda.is-destacada,
  .bio-svg__fagan-linea.is-destacada {
    stroke: var(--udg-navy-700);
    stroke-width: 2.5;
  }
  .bio-svg__curva.is-secundaria,
  .bio-svg__leyenda.is-secundaria,
  .bio-svg__fagan-linea.is-secundaria {
    stroke: var(--udg-gray-700);
    stroke-dasharray: 7 4;
  }
  .bio-svg__curva.is-trazo-2,
  .bio-svg__leyenda.is-trazo-2,
  .bio-svg__fagan-linea.is-trazo-2 {
    stroke: var(--udg-gray-500);
    stroke-dasharray: 1 5;
  }
  .bio-svg__curva.is-trazo-3,
  .bio-svg__leyenda.is-trazo-3,
  .bio-svg__fagan-linea.is-trazo-3 {
    stroke: var(--udg-gray-500);
    stroke-dasharray: 12 4 1 4;
  }
  .bio-svg__fagan-punto,
  .bio-svg__marcador-punto {
    fill: var(--udg-gray-700);
  }
  .bio-svg__fagan-punto.is-destacada,
  .bio-svg__marcador-punto.is-destacada {
    fill: var(--udg-navy-700);
  }
  .bio-svg__fagan-punto.is-trazo-2,
  .bio-svg__fagan-punto.is-trazo-3,
  .bio-svg__marcador-punto.is-trazo-2,
  .bio-svg__marcador-punto.is-trazo-3 {
    fill: var(--udg-gray-500);
  }
  .bio-svg__leyenda-texto,
  .bio-svg__fagan-rotulo {
    fill: var(--udg-gray-700);
  }

  /* Nomograma de Fagan. */
  .bio-svg__fagan-eje {
    stroke: var(--udg-gray-300);
    stroke-width: 1.2;
  }
  .bio-svg__fagan-tick {
    stroke: var(--udg-gray-300);
    stroke-width: 1;
  }
  .bio-svg__fagan-tick-texto {
    fill: var(--udg-gray-500);
    font-variant-numeric: tabular-nums;
    /* Las rectas cruzan el eje central justo por donde van sus números: un
       filete del color del fondo de la figura (blanco, igual que `.grafica`)
       los despega sin taparlas. Sobre fondo blanco es invisible. */
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .bio-svg__fagan-titulo,
  .bio-svg__eje-titulo {
    fill: var(--udg-navy-900);
    font-weight: 600;
  }

  /* Curvas e histograma: marcador vertical sobre la variable capturada. El
     destacado (la media observada frente a las estimadas) va en navy, nunca en
     rojo: en este componente el rojo no convive con el navy. */
  .bio-svg__marcador {
    stroke: var(--udg-gray-500);
    stroke-width: 1;
    stroke-dasharray: 4 3;
  }
  .bio-svg__marcador.is-destacada {
    stroke: var(--udg-navy-700);
    stroke-width: 1.5;
  }
  .bio-svg__marcador-texto {
    fill: var(--udg-gray-700);
    /* En barras este rótulo nombra la línea de referencia y cae sobre el área de
       trazado, a veces encima de una barra en navy: un filete del color del
       fondo de la figura lo despega, como en las marcas del nomograma. Sobre
       blanco es invisible. */
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 4;
    stroke-linejoin: round;
  }
  .bio-svg__marcador-texto.is-destacada {
    fill: var(--udg-navy-900);
    font-weight: 600;
  }
  /* Muestra del marcador en la leyenda: la misma línea discontinua que cruza los
     paneles, para que se reconozca sin leer la posición. Va después de
     `.is-destacada` genérico y con una clase más, así que gana. */
  .bio-svg__leyenda.is-marcador {
    stroke: var(--udg-gray-500);
    stroke-width: 1;
    stroke-dasharray: 4 3;
  }
  .bio-svg__leyenda.is-marcador.is-destacada {
    stroke: var(--udg-navy-700);
    stroke-width: 1.5;
  }

  /* Barras agrupadas (χ² y McNemar). La serie destacada se rellena en navy
     sólido; las demás, con una trama —diagonales o puntos— definida en el
     `<defs>` del propio SVG: impresa en blanco y negro la gráfica se sigue
     leyendo, que es la regla de la sección. El contorno gris delimita la barra
     cuando la trama la deja casi vacía. */
  .bio-svg__barra.is-destacada {
    fill: var(--udg-navy-700);
  }
  .bio-svg__barra.is-secundaria {
    stroke: var(--udg-gray-500);
    stroke-width: 1;
  }
  .bio-svg__trama {
    stroke: var(--udg-gray-500);
    stroke-width: 1;
  }
  .bio-svg__trama-punto {
    fill: var(--udg-gray-500);
  }
  /* Valor escrito sobre cada barra: con cifras tabulares las decenas y las
     unidades quedan alineadas entre barras vecinas. */
  .bio-svg__valor {
    fill: var(--udg-gray-700);
    font-variant-numeric: tabular-nums;
  }

  /* Histograma con curva normal y diagrama de caja debajo. Las clases del
     histograma llevan un filete blanco entre barras contiguas (no hay canal: las
     clases son contiguas por definición) y la curva normal va en navy, que es la
     lectura que se superpone a los datos. */
  .bio-svg__hist-barra {
    fill: var(--udg-gray-300);
    stroke: #fff;
    stroke-width: 1;
  }
  .bio-svg__normal {
    fill: none;
    stroke: var(--udg-navy-700);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bio-svg__caja {
    fill: var(--udg-gray-100);
    stroke: var(--udg-gray-700);
    stroke-width: 1.5;
  }
  .bio-svg__mediana {
    stroke: var(--udg-navy-700);
    stroke-width: 2.5;
  }
  .bio-svg__bigote {
    stroke: var(--udg-gray-700);
    stroke-width: 1.5;
  }
  .bio-svg__atipico {
    fill: none;
    stroke: var(--udg-gray-700);
    stroke-width: 1.5;
  }
</style>
