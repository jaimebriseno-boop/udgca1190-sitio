---
// Página de la herramienta "Dengue Forecast": marco institucional del sitio
// (Base + PageHeader) con el visor estático embebido por iframe. El visor vive en
// public/herramientas/dengue-forecast/app/ y es autocontenido (Plotly + JSON).
// Opción B de las INSTRUCCIONES del visor; auto-ajuste de altura por postMessage.
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import { t } from '../../i18n.mjs';

interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;

// Sin `state` => default Nacional. `origin=2022-01` abre en el inicio del resurgimiento
// DENV-3, para que el usuario mueva el slider y vea cómo el modelo predice hacia adelante.
const appBase = '/herramientas/dengue-forecast/app/';
const embedSrc = `${appBase}?lang=${lang}&origin=2022-01&embed=1`;
const fullSrc = `${appBase}?lang=${lang}&origin=2022-01`;

// Preprint que respalda la herramienta (en evaluación por pares, Research Square).
const citeDoi = '10.21203/rs.3.rs-10035640/v1';
const citeUrl = `https://doi.org/${citeDoi}`;
---
<Base titulo={t(lang, 'dengue.title')} descripcion={t(lang, 'dengue.meta')} lang={lang}>
  <PageHeader eyebrow={t(lang, 'dengue.kicker')} title={t(lang, 'dengue.title')} description={t(lang, 'dengue.intro')} />
  <section class="section">
    <div class="container">
      <div class="tool-toolbar">
        <a class="fullscreen-link" href={fullSrc} target="_blank" rel="noopener">{t(lang, 'dengue.fullscreen')}</a>
      </div>
      <div class="viewer-frame">
        <iframe
          id="dengueFrame"
          src={embedSrc}
          title={t(lang, 'dengue.iframe_title')}
          loading="lazy"
          referrerpolicy="no-referrer"></iframe>
      </div>
      <p class="viewer-note">{t(lang, 'dengue.note')}</p>

      <aside class="cite" aria-label={t(lang, 'dengue.cite_heading')}>
        <div class="cite__head">
          <h2 class="cite__title">{t(lang, 'dengue.cite_heading')}</h2>
          <span class="cite__status">{t(lang, 'dengue.cite_status')}</span>
        </div>
        <p class="cite__text">{t(lang, 'dengue.cite_text')}</p>
        <p class="cite__doi">
          <a href={citeUrl} target="_blank" rel="noopener">{t(lang, 'dengue.cite_doi')}</a>
          <span class="cite__id">DOI: {citeDoi}</span>
        </p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .section { padding-block-start: var(--sp-6); }
  .tool-toolbar { display: flex; justify-content: flex-end; margin-bottom: var(--sp-2); }
  .fullscreen-link { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--udg-navy-700); }
  .fullscreen-link:hover { color: var(--udg-red-600); }
  .viewer-frame {
    border: 1px solid var(--udg-gray-200);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg, #fff);
  }
  #dengueFrame {
    display: block;
    width: 100%;
    border: 0;
    /* respaldo si el postMessage de altura no llegara */
    min-height: 1100px;
  }
  .viewer-note {
    margin-top: var(--sp-2);
    color: var(--c-gray);
    font-size: var(--fs-sm);
  }
  .cite {
    margin-top: var(--sp-4);
    padding: var(--sp-3);
    border: 1px solid var(--udg-gray-200);
    border-left: 3px solid var(--udg-red-600);
    border-radius: var(--radius-md, 8px);
    background: var(--udg-gray-50, #f7f7f8);
  }
  .cite__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-2);
  }
  .cite__title {
    font-size: var(--fs-s1);
    font-weight: var(--fw-semibold);
    margin: 0;
  }
  .cite__status {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--udg-navy-700);
    background: var(--udg-gray-200);
    padding: 2px 8px;
    border-radius: 999px;
  }
  .cite__text {
    color: var(--c-gray);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed, 1.6);
    margin: 0 0 var(--sp-2);
  }
  .cite__doi {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-3);
    margin: 0;
  }
  .cite__doi a {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--udg-red-600);
    font-weight: var(--fw-semibold);
  }
  .cite__id {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-gray);
  }
</style>

<script>
  // El visor reporta su altura al contenedor: { type: 'dengue-height', height }.
  const frame = document.getElementById('dengueFrame') as HTMLIFrameElement | null;
  window.addEventListener('message', (e) => {
    const d = e.data;
    if (frame && d && d.type === 'dengue-height' && typeof d.height === 'number' && d.height > 0) {
      frame.style.height = d.height + 'px';
      frame.style.minHeight = '0';
    }
  });
</script>
