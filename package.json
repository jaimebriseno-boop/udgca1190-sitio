{
  "name": "udg-ca-1190-sitio",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Sitio web del Cuerpo Académico UDG-CA-1190 «Investigación Integrativa de Factores Biológicos del Proceso Salud-Enfermedad» (UdeG · CUTlajomulco)",
  "scripts": {
    "fonts": "node scripts/prepare-fonts.mjs",
    "predev": "npm run fonts",
    "prebuild": "npm run fonts",
    "precheck": "npm run fonts",
    "test:performance": "node --test scripts/performance.test.mjs",
    "test:bio": "node --test 'tests/bioestadistica/*.test.ts'",
    "test": "npm run test:performance && npm run test:bio",
    "fixtures:bio": "node scripts/bio-fixtures.mjs",
    "fixtures:bio:check": "node scripts/bio-fixtures.mjs --check",
    "barrido:bio": "node scripts/bio-barrido.mjs",
    "humo:webr": "node scripts/bio-humo-webr.mjs",
    "audit:performance": "python3 scripts/audit-performance.py",
    "dev": "astro dev",
    "build": "npm run tokens && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "tokens": "node scripts/tokens-to-css.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@retorquere/bibtex-parser": "^10.0.0",
    "astro": "^6.4.4",
    "js-yaml": "^4.2.0",
    "katex": "^0.18.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.5",
    "typescript": "^6.0.3"
  }
}
